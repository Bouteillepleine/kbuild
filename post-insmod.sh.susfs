#!/system/bin/sh
# SUSFS rules, applied right after susfs_guard_lkm.ko loads.
# Copy to /data/adb/lkm/post-insmod.sh, chmod 700. Output -> /data/adb/lkm/log.
#
# ===========================================================================
# MEASURED ON DEVICE, 6.12.58 / OP15 -- read before editing
# ===========================================================================
# 1. Hiding a CHILD of /data/adb does nothing. An app reaching
#    /data/adb/<anything> must traverse /data/adb, which is 0700 root:root, and
#    inode_permission() runs the DAC check BEFORE security_inode_permission().
#    So the app gets EACCES from the parent and this module's hook is never
#    called -- the rule is registered, the ENOENT counters stay at zero.
#    Verified: six such rules applied, counters did not move.
#
# 2. The only rule with real effect is /data/adb itself. stat(2) needs no
#    permission on the target, so an app CAN stat /data/adb and learn it exists
#    -- that is the actual leak -- and the inode_getattr hook turns exactly that
#    into ENOENT. Verified: app stat -> "No such file or directory", root
#    unaffected, counters moved.
#
# 3. Who it hides from is KernelSU's business, not a guess. Upstream SUSFS hides
#    only from apps it has umounted (TIF_PROC_UMOUNTED && uid >= 10000). An LKM
#    cannot read that thread flag, so this module USED to test "uid >= 10000"
#    alone and hid from EVERY app, the KernelSU manager included -- which is the
#    only reason the switch below defaulted to 0.
#    It now calls KernelSU's own ksu_uid_should_umount(), the same function its
#    UID_SHOULD_UMOUNT ioctl wraps, so hiding applies to exactly the apps you
#    ticked "Umount modules" for. The manager is excluded by KernelSU itself,
#    and so are apps you granted su. Check which build you are running:
#      dmesg | grep -E 'hide gate|ksu_umount_gate|is_magisk=1'
#    "following KernelSU's DenyList"  -> DenyList (builds up to 2026-10-10)
#    "ksu_uid_should_umount is present" -> DenyList (current builds)
#    "falling back to uid >= 10000"   -> old behaviour, set HIDE_DATA_ADB=0.
#    "is_magisk=1"                    -> no KernelSU to ask, same old behaviour.
#    Two generations, because the loader and the .ko ship separately and either
#    can be older than the other.
#
#    Current builds reach that function as a LINK-TIME import filled in by
#    whoever loads the .ko, not through kallsyms. That buys the LKM-KernelSU
#    case the old lookup could never serve, and costs a new failure mode: the
#    gate is the first and FATAL init layer, so if the symbol cannot be
#    supplied the module REFUSES TO LOAD rather than quietly hiding from every
#    app. "refusing to load" in dmesg is that, and the cause is one of:
#      - kernelsu.ko is not loaded yet -> load this module after it;
#      - KernelSU is older than that symbol;
#      - no KernelSU at all -> load with susfs_insmod, which passes is_magisk=1.
#    A non-zero "Exit code" in the loader log with no rules applied is this.
#
# 4. Follows from 3: if your global "Umount modules" default is off and an app
#    is not in the denylist, nothing is hidden from it. That is intended -- it
#    is what upstream does -- but it means the rules look inert until you tick
#    the apps you actually care about.
#
#    Recovery never needs the manager:
#      adb shell su -c 'echo "del /data/adb" > /proc/susfs_path'
#    or just reboot with the hook removed.
# ===========================================================================

# 1 = hide /data/adb from the apps KernelSU umounts for (closes the stat leak)
# 0 = leave it visible
HIDE_DATA_ADB=1

SUSFS=/data/adb/ksu/bin/ksu_susfs
[ -x "$SUSFS" ] || { echo "hook: no ksu_susfs"; exit 0; }
if ! "$SUSFS" show version >/dev/null 2>&1; then
    echo "hook: susfs supercall not answering - is susfs_guard_lkm loaded?"
    exit 0
fi
echo "hook: susfs $("$SUSFS" show version 2>/dev/null) is up"

if [ "$HIDE_DATA_ADB" = "1" ]; then
    if "$SUSFS" add_sus_path /data/adb >/dev/null 2>&1; then
        echo "hook:   /data/adb hidden from denylisted apps"
    else
        echo "hook:   FAILED to hide /data/adb"
    fi
else
    echo "hook:   /data/adb left visible (HIDE_DATA_ADB=0)"
fi

# Paths OUTSIDE /data/adb are worth hiding, because nothing denies traversal
# first -- these are reachable by apps today. Add your own; they do fire.
# /sdcard/Download too: anykernel.sh now drops the module there during a kernel flash,
# and /sdcard/susfs*.ko does not match one directory deeper - our own delivery path was
# leaving a susfs .ko outside the hide list.
for p in /data/local/tmp/susfs*.ko /sdcard/susfs*.ko \
         /sdcard/Download/susfs*.ko /storage/emulated/0/Download/susfs*.ko; do
    [ -e "$p" ] || continue
    "$SUSFS" add_sus_path "$p" >/dev/null 2>&1 && echo "hook:   hid $p"
done

# Record which hide gate the module reported at init, BEFORE logging goes off and before
# dmesg rotates past it. It is the one line that says whether hiding follows KernelSU's
# DenyList or the old uid >= 10000 proxy, it is printed once per load, and by the time
# anyone looks it is usually gone - so the WebUI reads this file, not dmesg.
# Both generations of the message, and the refusal: 'hide gate' also catches the
# current wording ("the hide gates ..."), but only by substring, so the names are
# spelled out rather than left to luck.
GATE=$(dmesg 2>/dev/null | grep -E 'hide gate|ksu_umount_gate|is_magisk=1|refusing to load' | tail -1)
if [ -n "$GATE" ]; then
    printf '%s\n' "$GATE" > /data/adb/lkm/hide-gate
    chmod 600 /data/adb/lkm/hide-gate
fi

# Last: every rule above is logged to dmesg as it is added, which is its own
# trace. Comment out while debugging.
"$SUSFS" enable_log 0 >/dev/null 2>&1 && echo "hook: kernel logging off"

# susfs4ksu's WebUI tiles count only the paths IT applied, so they read 0 while the
# kernel enforces these. Refresh its cache from live state; boot-completed.sh keeps
# re-asserting it, because that module rewrites the file in its own boot-completed.
# -s, not -x: `ksud module install` lands every script 0644 no matter what mode the zip
# carried, so an -x guard here silently skips. It is run through `sh` either way.
STATS=/data/adb/modules/susfs_lkm_loader/stats.sh
[ -s "$STATS" ] && sh "$STATS" && echo "hook:   refreshed susfs4ksu stats"

echo "hook: done"
exit 0
