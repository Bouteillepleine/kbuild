diff --git a/os_dep/linux/ioctl_cfg80211.c b/os_dep/linux/ioctl_cfg80211.c
--- a/os_dep/linux/ioctl_cfg80211.c
+++ b/os_dep/linux/ioctl_cfg80211.c
@@ -2759,7 +2759,18 @@
 #else
 		ndev->type = ARPHRD_IEEE80211_RADIOTAP; /* IEEE 802.11 + radiotap header : 803 */
 #endif
-		break;
+		/* ---- DEBUG BISECT ROUND 1 -- NOT FOR RELEASE ----
+		 * `iw dev wlanX set type monitor` panics the kernel on 6.12.
+		 * Return here, after the ndev->type change but BEFORE
+		 * rtw_set_802_11_infrastructure_mode() and rtw_setopmode_cmd(),
+		 * to determine which half owns the panic.
+		 *   no panic  -> panic is in the mode-set / HAL path
+		 *   panic     -> panic is the ndev->type change itself
+		 */
+		rtw_wdev->iftype = type;
+		ret = 0;
+		RTW_INFO("BISECT1: monitor type set, skipping mode-set calls\n");
+		goto exit;
 #endif /* CONFIG_WIFI_MONITOR */
 	default:
 		ret = -EOPNOTSUPP;
