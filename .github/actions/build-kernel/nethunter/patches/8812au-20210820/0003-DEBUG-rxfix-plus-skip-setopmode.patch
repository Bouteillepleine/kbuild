diff --git a/core/rtw_recv.c b/core/rtw_recv.c
--- a/core/rtw_recv.c
+++ b/core/rtw_recv.c
@@ -4068,38 +4068,66 @@
 
 #ifdef CONFIG_WIFI_MONITOR
 	struct net_device *ndev = padapter->pnetdev;
-	_pkt *pskb = NULL;
 
 	if (rframe == NULL)
 		goto exit;
 
-	/* read skb information from recv frame */
-	pskb = rframe->u.hdr.pkt;
-	pskb->len = rframe->u.hdr.len;
-	pskb->data = rframe->u.hdr.rx_data;
-	skb_set_tail_pointer(pskb, rframe->u.hdr.len);
-
-	if (ndev->type == ARPHRD_IEEE80211_RADIOTAP) {
-		/* fill radiotap header */
-		if (rtw_fill_radiotap_hdr(padapter, &rframe->u.hdr.attrib, (u8 *)pskb) == _FAIL) {
+	/* Deliver monitor frames in a freshly allocated skb instead of mutating
+	 * the driver's own recv skb in place.
+	 *
+	 * The original code assigned skb->data, skb->len and the tail pointer
+	 * directly and then let rtw_fill_radiotap_hdr() skb_push() a radiotap
+	 * header onto the result, without validating any of it against
+	 * skb->head / skb->end. On 6.12 that breaks skb invariants and panics the
+	 * kernel on the first frame received in monitor mode (reproduced on OP15,
+	 * bisected to this path). Copying into a new skb with real headroom keeps
+	 * rtw_fill_radiotap_hdr() unchanged -- its own headroom check now always
+	 * passes -- and leaves the recv frame untouched for the normal
+	 * rtw_free_recvframe() path below, so the lifetime rules are unchanged.
+	 */
+	{
+		/* must exceed RTAP_HDR_MAX (64) in core/monitor/rtw_radiotap.c */
+		const u32 rtap_room = 128;
+		u32 frame_len = rframe->u.hdr.len;
+		u8 *frame_data = rframe->u.hdr.rx_data;
+		_pkt *nskb;
+
+		if (!frame_data || frame_len == 0 || frame_len > 8192) {
+			ret = _FAIL;
+			goto exit;
+		}
+
+		nskb = rtw_skb_alloc(rtap_room + frame_len);
+		if (!nskb) {
 			ret = _FAIL;
 			goto exit;
 		}
-	}
 
-	/* write skb information to recv frame */
-	skb_reset_mac_header(pskb);
-	rframe->u.hdr.len = pskb->len;
-	rframe->u.hdr.rx_data = pskb->data;
-	rframe->u.hdr.rx_head = pskb->head;
-	rframe->u.hdr.rx_tail = skb_tail_pointer(pskb);
-	rframe->u.hdr.rx_end = skb_end_pointer(pskb);
-
-	if (!RTW_CANNOT_RUN(padapter)) {
-		/* indicate this recv_frame */
-		ret = rtw_recv_monitor(padapter, rframe);
-	} else 
-		ret = _FAIL;
+		skb_reserve(nskb, rtap_room);
+		_rtw_memcpy(skb_put(nskb, frame_len), frame_data, frame_len);
+
+		if (ndev->type == ARPHRD_IEEE80211_RADIOTAP) {
+			if (rtw_fill_radiotap_hdr(padapter, &rframe->u.hdr.attrib,
+						  (u8 *)nskb) == _FAIL) {
+				rtw_skb_free(nskb);
+				ret = _FAIL;
+				goto exit;
+			}
+		}
+
+		skb_reset_mac_header(nskb);
+		nskb->ip_summed = CHECKSUM_NONE;
+		nskb->pkt_type = PACKET_OTHERHOST;
+		nskb->protocol = htons(0x0019); /* ETH_P_80211_RAW */
+
+		if (!RTW_CANNOT_RUN(padapter)) {
+			rtw_netif_rx(ndev, nskb);
+			ret = _SUCCESS;
+		} else {
+			rtw_skb_free(nskb);
+			ret = _FAIL;
+		}
+	}
 
 exit:
 #endif /* CONFIG_WIFI_MONITOR */
diff --git a/os_dep/linux/ioctl_cfg80211.c b/os_dep/linux/ioctl_cfg80211.c
--- a/os_dep/linux/ioctl_cfg80211.c
+++ b/os_dep/linux/ioctl_cfg80211.c
@@ -2774,6 +2774,19 @@
 		goto exit;
 	}
 
+	/* ---- DEBUG BISECT ROUND 2 -- NOT FOR RELEASE ----
+	 * Round 1 showed the panic is in the mode-set half of this function.
+	 * Keep rtw_set_802_11_infrastructure_mode() (it sets WIFI_MONITOR_STATE
+	 * so the real monitor RX path is reachable) but skip rtw_setopmode_cmd(),
+	 * which is what reaches hw_var_set_monitor()'s raw RCR/RXFLTMAP writes.
+	 *   no panic -> rtw_setopmode_cmd / HAL owns it
+	 *   panic    -> rtw_set_802_11_infrastructure_mode owns it
+	 */
+	if (type == NL80211_IFTYPE_MONITOR) {
+		RTW_INFO("BISECT2: skipping rtw_setopmode_cmd for monitor\n");
+		ret = 0;
+		goto exit;
+	}
 	rtw_setopmode_cmd(padapter, networkType, RTW_CMDF_WAIT_ACK);
 #ifdef CONFIG_MONITOR_MODE_XMIT
 	if (check_fwstate(pmlmepriv, WIFI_MONITOR_STATE) == _TRUE)
