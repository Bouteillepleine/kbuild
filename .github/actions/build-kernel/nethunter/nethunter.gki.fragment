# EmberHeart / Nethunter kernel config fragment (GKI arm64, 6.12).
# Appended to gki_defconfig before the build; olddefconfig prunes any
# symbol not present on this kernel, so unknown/renamed keys are safe.

# --- USB gadget: BadUSB / HID keyboard, DriveDroid mass storage, ethernet ---
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y

# --- host-side USB for external adapters (serial, ACM, HID) ---
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_USB_SERIAL_CP210X=y

# NOTE: cfg80211/mac80211/rfkill are intentionally NOT set here. OP15's internal
# WLAN already provides them; forcing their state (esp. RFKILL=y, which reassigns
# the base value) bootloops the device. The out-of-tree injection drivers link
# against the base cfg80211 regardless.

# --- netfilter extras for MITM / packet manipulation ---
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NETFILTER_XT_TARGET_TPROXY=m
CONFIG_NETFILTER_XT_MATCH_MAC=m
CONFIG_NF_TABLES=m
CONFIG_IP_NF_TARGET_REDIRECT=m
